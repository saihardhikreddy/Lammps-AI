units           metal
atom_style      atomic
boundary        p p p

lattice         fcc 3.615
region          box block 0 5 0 5 0 5
create_box      1 box
create_atoms    1 box
mass            1 63.546

pair_style      eam/alloy
pair_coeff      * * Cu_zhou.eam.alloy Cu

velocity        all create 300.0 8274 dist gaussian
fix             1 all npt temp 300.0 300.0 0.1 iso 0.0 0.0 1.0

thermo          50
thermo_style    custom step temp pe ke etotal press vol

run             500